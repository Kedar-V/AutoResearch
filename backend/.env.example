AUTORESEARCH_DATABASE_URL=postgresql+psycopg://autoresearch:autoresearch@localhost:5432/autoresearch
AUTORESEARCH_PROJECT_ROOT=/absolute/path/to/a/trusted/git/repository
AUTORESEARCH_RUNTIME_ROOT=/absolute/path/to/runtime-data
AUTORESEARCH_CHAMPION_BRANCH=master
AUTORESEARCH_ALLOWED_ORIGINS=http://localhost:5173
AUTORESEARCH_SCRIPT_TIMEOUT_SECONDS=300
AUTORESEARCH_PROTECTED_PATHS=eval.py,tests,.research
AUTORESEARCH_GITHUB_OWNER=Kedar-V
# Execution agent (set one): preferred Cursor SDK key for composer-2.5
CURSOR_API_KEY=
# Fallback LLM editor when CURSOR_API_KEY is unset
OPENAI_API_KEY=
AUTORESEARCH_OPENAI_MODEL=gpt-4.1

# Agent observability (optional). Core loop works with backend=noop (default).
# Pick one:
#   noop                 — no vendor
#   langfuse-cloud       — Langfuse Cloud Free/Pro (set keys; host defaults to cloud)
#   langfuse-selfhost    — local OSS via `make langfuse-selfhost-up` (host → localhost:3000)
#   langfuse             — generic: use whatever LANGFUSE_HOST + keys you set
AUTORESEARCH_OBSERVABILITY_BACKEND=noop
AUTORESEARCH_LANGFUSE_PUBLIC_KEY=
AUTORESEARCH_LANGFUSE_SECRET_KEY=
AUTORESEARCH_LANGFUSE_HOST=https://cloud.langfuse.com
# Self-host example (after make langfuse-selfhost-up):
# AUTORESEARCH_OBSERVABILITY_BACKEND=langfuse-selfhost
# AUTORESEARCH_LANGFUSE_PUBLIC_KEY=pk-lf-autoresearch-local
# AUTORESEARCH_LANGFUSE_SECRET_KEY=sk-lf-autoresearch-local-dev-secret
# AUTORESEARCH_LANGFUSE_HOST=http://localhost:3000

# Agent memory (optional). Core loop works with backend=noop (default).
# Git/Postgres remain the research SoR; memory is preferences / soft lessons only.
# Pick one:
#   noop        — off
#   honcho      — Plastic Labs Honcho (requires memory extra: pip install '.[memory]')
#   hindsight   — Vectorize Hindsight (install their client SDK separately)
#   composite   — fan-out retain + merged recall (set MEMORY_PROVIDERS)
AUTORESEARCH_MEMORY_BACKEND=noop
AUTORESEARCH_MEMORY_PROVIDERS=
AUTORESEARCH_HONCHO_API_KEY=
AUTORESEARCH_HONCHO_WORKSPACE_ID=autoresearch
AUTORESEARCH_HONCHO_BASE_URL=
AUTORESEARCH_HINDSIGHT_API_KEY=
AUTORESEARCH_HINDSIGHT_API_URL=
AUTORESEARCH_HINDSIGHT_BANK_PREFIX=autoresearch
# Composite example:
# AUTORESEARCH_MEMORY_BACKEND=composite
# AUTORESEARCH_MEMORY_PROVIDERS=honcho,hindsight
