AUTORESEARCH_DATABASE_URL=postgresql+psycopg://autoresearch:autoresearch@localhost:5432/autoresearch
AUTORESEARCH_PROJECT_ROOT=/absolute/path/to/a/trusted/git/repository
AUTORESEARCH_RUNTIME_ROOT=/absolute/path/to/runtime-data
AUTORESEARCH_CHAMPION_BRANCH=master
AUTORESEARCH_ALLOWED_ORIGINS=http://localhost:5173
AUTORESEARCH_SCRIPT_TIMEOUT_SECONDS=300
AUTORESEARCH_PROTECTED_PATHS=eval.py,tests,.research
