{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoresearch.local/schemas/evaluation/v2",
  "title": "AutoResearch evaluation record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_id",
    "trial_id",
    "hypothesis_id",
    "run_id",
    "status",
    "metrics",
    "champion_metrics",
    "deltas",
    "primary_metric",
    "direction",
    "summary",
    "signals",
    "recommendation",
    "rationale",
    "risks",
    "evidence",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "2" },
    "evaluation_id": { "type": "string", "minLength": 1 },
    "trial_id": { "type": "string", "pattern": "^H[0-9]{4,}/T[0-9]{3,}$" },
    "hypothesis_id": { "type": "string", "pattern": "^H[0-9]{4,}$" },
    "run_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["passed", "failed", "invalid"] },
    "metrics": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "champion_metrics": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "deltas": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "primary_metric": { "type": "string", "minLength": 1 },
    "direction": { "enum": ["minimize", "maximize"] },
    "summary": { "type": "string" },
    "signals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["improved", "regressed", "unchanged"],
      "properties": {
        "improved": { "type": "array", "items": { "type": "string" } },
        "regressed": { "type": "array", "items": { "type": "string" } },
        "unchanged": { "type": "array", "items": { "type": "string" } }
      }
    },
    "recommendation": { "enum": ["accept", "reject", "retry"] },
    "rationale": { "type": "string" },
    "risks": { "type": "string" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_commit", "evaluator_commit"],
      "properties": {
        "duration_seconds": { "type": "number", "minimum": 0 },
        "candidate_commit": { "type": "string" },
        "evaluator_commit": { "type": "string" },
        "stdout_excerpt": { "type": "string" }
      }
    },
    "model": { "type": "string" },
    "system_prompt_hash": { "type": "string" },
    "agent_trace_id": { "type": "string" },
    "prompt_version": { "type": "string" },
    "observability_backend": { "type": "string" },
    "explainability": {
      "type": "object",
      "description": "Optional user-defined explainability fields validated by the evaluation agent against explainability_schema on the evaluation node.",
      "additionalProperties": true
    },
    "explainability_schema_hash": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
