{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoresearch.local/schemas/frontier/v1",
  "title": "AutoResearch Pareto frontier manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "points", "updated_at"],
  "properties": {
    "schema_version": { "const": "1" },
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["commit", "trial_id", "metrics"],
        "properties": {
          "commit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
          "trial_id": { "type": "string", "pattern": "^H[0-9]{4,}/T[0-9]{3,}$" },
          "metrics": {
            "type": "object",
            "additionalProperties": { "type": "number" }
          }
        }
      }
    },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
