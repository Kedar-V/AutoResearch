{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoresearch.local/schemas/hypothesis/v1",
  "title": "AutoResearch hypothesis record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "description", "base_commit", "branch", "created_at"],
  "properties": {
    "schema_version": { "const": "1" },
    "id": { "type": "string", "pattern": "^H[0-9]{4,}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "description": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "base_commit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "branch": { "type": "string", "pattern": "^hypothesis/" },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
