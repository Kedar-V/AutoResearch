{
  "schema_version": "1",
  "id": "basic-research-loop",
  "name": "Basic research loop",
  "description": "Minimize score across hypotheses with gate-driven champion feedback.",
  "nodes": [
    {
      "id": "hypothesis",
      "type": "hypothesis",
      "name": "Improve score",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "title": "Lower the score",
        "description": "Reduce score.txt by one each accepted hypothesis.",
        "system_prompt": "Produce a concrete next experiment for score.txt. Use the last history_window hypotheses: reuse what worked, avoid what did not. Name exact edits and the expected metric effect.",
        "model": "composer-2.5",
        "max_retries": 1,
        "max_hypotheses": 5,
        "history_window": 10
      }
    },
    {
      "id": "execution",
      "type": "execution",
      "name": "Train candidate",
      "position": {
        "x": 280,
        "y": 0
      },
      "config": {
        "command": [
          "python",
          "train.py"
        ],
        "timeout_seconds": 30,
        "commit_message": "trial: decrement score"
      }
    },
    {
      "id": "eval_script",
      "type": "eval_script",
      "name": "Evaluate candidate",
      "position": {
        "x": 280,
        "y": 180
      },
      "config": {
        "command": [
          "python",
          "eval.py"
        ],
        "timeout_seconds": 30,
        "protected_paths": [
          "eval.py",
          "tests",
          ".research"
        ]
      }
    },
    {
      "id": "evaluation",
      "type": "evaluation",
      "name": "Evaluation agent",
      "position": {
        "x": 560,
        "y": 0
      },
      "config": {
        "system_prompt": "Summarize metric movement.",
        "model": "composer-2.5"
      }
    },
    {
      "id": "gate",
      "type": "metric_gate",
      "name": "Accept improvement",
      "position": {
        "x": 840,
        "y": 0
      },
      "config": {
        "metric": "score",
        "direction": "minimize",
        "baseline": 5.0,
        "min_delta": 0.01
      }
    },
    {
      "id": "decision",
      "type": "git_decision",
      "name": "Record decision",
      "position": {
        "x": 1120,
        "y": 0
      },
      "config": {}
    },
    {
      "id": "database",
      "type": "database",
      "name": "DB",
      "position": {
        "x": 560,
        "y": 220
      },
      "config": {}
    }
  ],
  "edges": [
    {
      "id": "hypothesis-to-execution",
      "source": "hypothesis",
      "target": "execution"
    },
    {
      "id": "execution-to-eval-script",
      "source": "execution",
      "target": "eval_script"
    },
    {
      "id": "execution-to-evaluation",
      "source": "execution",
      "target": "evaluation"
    },
    {
      "id": "eval-script-to-evaluation",
      "source": "eval_script",
      "target": "evaluation"
    },
    {
      "id": "evaluation-to-gate",
      "source": "evaluation",
      "target": "gate"
    },
    {
      "id": "gate-to-decision",
      "source": "gate",
      "target": "decision"
    },
    {
      "id": "execution-to-hypothesis",
      "source": "execution",
      "target": "hypothesis"
    },
    {
      "id": "decision-to-hypothesis",
      "source": "decision",
      "target": "hypothesis"
    }
  ]
}
