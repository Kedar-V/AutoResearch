# Local Langfuse OSS (self-host) — used by `make langfuse-selfhost-up`
# Dev-only secrets. Change before any shared/production use.

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=autoresearch-langfuse-nextauth-dev-secret-change-me
SALT=autoresearch-langfuse-salt-dev-change-me
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/postgres
POSTGRES_PASSWORD=postgres
CLICKHOUSE_PASSWORD=clickhouse
REDIS_AUTH=myredissecret
MINIO_ROOT_PASSWORD=miniosecret
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=miniosecret
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=miniosecret
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=miniosecret

# Seed an AutoResearch project + API keys on first boot (no UI click required).
LANGFUSE_INIT_ORG_ID=autoresearch-org
LANGFUSE_INIT_ORG_NAME=AutoResearch
LANGFUSE_INIT_PROJECT_ID=autoresearch
LANGFUSE_INIT_PROJECT_NAME=AutoResearch
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-autoresearch-local
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-autoresearch-local-dev-secret
LANGFUSE_INIT_USER_EMAIL=admin@autoresearch.local
LANGFUSE_INIT_USER_NAME=AutoResearch Admin
LANGFUSE_INIT_USER_PASSWORD=changeme-langfuse-admin

TELEMETRY_ENABLED=false
